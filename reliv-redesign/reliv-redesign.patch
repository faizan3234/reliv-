diff --git a/experience.css b/experience.css
new file mode 100644
index 0000000..d744071
--- /dev/null
+++ b/experience.css
@@ -0,0 +1,15 @@
+/* Native-scroll editorial experience; existing interior-page styles are retained. */
+:root{--r-orange:#f35b22;--r-cream:#f6f1e7;--r-ink:#292b24;--r-line:#dcd8cd}
+.reliv-home{background:var(--r-cream);color:var(--r-ink)}.reliv-home::after{display:none}.reliv-home header{background:#f6f1e7f0;border:1px solid var(--r-line);box-shadow:none;backdrop-filter:blur(16px)}.reliv-home .container{max-width:1400px}.reliv-home h2{font-size:clamp(38px,5.6vw,84px);letter-spacing:-.055em;line-height:1.04;font-weight:500}.reliv-home h2 em{color:var(--r-orange)}.reliv-home .btn-primary{background:var(--r-ink);box-shadow:none;border-color:var(--r-ink)}
+.r-language select{font:inherit;font-size:13px;border:1px solid var(--r-line);border-radius:30px;padding:10px;background:transparent;color:var(--r-ink);max-width:115px}.r-skip{position:fixed;top:-100px;left:20px;z-index:10001;background:white;padding:15px}.r-skip:focus{top:10px}.r-sr{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
+.r-hero{position:relative;min-height:900px;min-height:calc(100svh - 20px);padding:125px 5% 45px;overflow:hidden;isolation:isolate;background:var(--r-cream)}.r-hero-top{display:flex;justify-content:space-between;font:500 11px/1.4 var(--font-sans);letter-spacing:.16em;border-top:1px solid var(--r-line);padding-top:18px}.r-hero h1{position:relative;z-index:2;font-size:clamp(80px,11.8vw,190px);line-height:.88;letter-spacing:-.075em;font-weight:500;margin:65px 0 0;max-width:80%;pointer-events:none}.r-hero h1 em{font-family:var(--font-serif);font-weight:400;color:var(--r-orange);letter-spacing:-.055em}.r-product{position:absolute;z-index:1;left:58%;top:12%;width:31%;height:73%;transform:rotate(8deg);animation:r-enter 1.5s cubic-bezier(.16,1,.3,1) both}.r-product img{height:100%;width:100%;object-fit:contain;filter:drop-shadow(24px 30px 20px #292b241b)}.r-orbit{position:absolute;width:50vw;height:50vw;max-height:780px;max-width:780px;border:1px solid #d7cfbf;border-radius:50%;left:46%;top:8%;z-index:-1;background:radial-gradient(circle,#efe4d2,transparent 67%)}.r-orbit::after{content:'';position:absolute;inset:12%;border:1px solid #ded7c8;border-radius:50%}
+.r-float{position:absolute;z-index:3;display:flex;gap:30px;align-items:center;font-size:15px;padding:15px 22px;border-radius:40px;background:var(--r-cream);border:1px solid #ccc5b8;animation:r-float 6s ease-in-out infinite}.r-one{right:6%;top:25%;background:var(--r-orange);color:white;border:0;transform:rotate(8deg)}.r-two{right:29%;top:63%;animation-delay:-2s}.r-three{right:4%;top:65%;animation-delay:-4s}.r-hero-bottom{position:relative;z-index:4;margin-top:70px;max-width:420px}.r-hero-bottom p{font-size:17px;line-height:1.6;color:#626357;margin:0 0 25px}.r-actions{display:flex;flex-wrap:wrap;align-items:center;gap:18px}.r-pill{display:inline-flex;border-radius:40px;background:var(--r-ink);color:#fff!important;padding:18px 27px;font-size:14px;transition:background .2s,transform .3s}.r-pill:hover{background:var(--r-orange);transform:translateY(-3px)}.r-link{display:inline-block;font-size:14px;border-bottom:1px solid currentColor;padding:8px 0;color:inherit}.r-scroll{display:block;margin-top:38px;font-size:10px;letter-spacing:.16em}
+.r-band{background:var(--r-orange);color:#fff6e7;position:relative;padding:28px 0 45px;overflow:hidden;transform:rotate(-1.2deg);margin:20px 0 0}.r-band-track{display:flex;width:max-content;animation:r-marquee 60s linear infinite}.r-band-track>div{white-space:nowrap;font-size:clamp(25px,3vw,48px);font-weight:500;letter-spacing:-.03em;padding-right:30px}.r-band i{font-style:normal;padding:0 22px}.r-motion{position:absolute;right:4%;bottom:7px;color:inherit;border:0;background:transparent;text-decoration:underline;font-size:12px;cursor:pointer;min-height:32px}
+.r-intro{display:grid;grid-template-columns:1.15fr 1fr;gap:80px;padding-top:120px;padding-bottom:55px;align-items:end}.r-intro h2{margin:18px 0 0}.r-intro .body-lead{font-size:22px;line-height:1.5}.r-note{font-size:12px;line-height:1.7;max-width:470px;color:#68695e;margin-top:20px}.r-explorer{padding-bottom:100px}.r-categories{display:flex;gap:10px;border-bottom:1px solid var(--r-line);padding-bottom:25px;flex-wrap:wrap}.r-categories button{padding:14px 24px;border:1px solid var(--r-line);border-radius:30px;background:transparent;color:inherit;cursor:pointer;font:inherit;font-size:14px}.r-categories button[aria-pressed=true]{background:var(--r-ink);color:white;border-color:var(--r-ink)}.r-metric-layout{display:grid;grid-template-columns:1fr 1.15fr;gap:70px;padding-top:35px}.r-metric-choices{display:flex;flex-direction:column}.r-metric-choices button{background:none;border:0;border-bottom:1px solid var(--r-line);padding:19px 0;display:flex;justify-content:space-between;color:#68695e;text-align:start;font:inherit;font-size:clamp(17px,2vw,26px);cursor:pointer;transition:color .2s,padding .2s}.r-metric-choices button[aria-pressed=true]{color:#b54115;padding-inline:14px}.r-metric-detail{background:#eae7dc;border-radius:3px;padding:50px;align-self:start;min-height:410px}.r-metric-detail h3{font-size:clamp(30px,4vw,60px);letter-spacing:-.045em;line-height:1.05;margin:20px 0}.r-metric-detail p{font-size:16px;line-height:1.7;max-width:430px;margin-bottom:18px}.r-signal{height:75px;display:flex;align-items:center;gap:8px;margin:25px 0}.r-signal span{height:30%;width:8%;border-radius:10px;background:var(--r-orange)}.r-signal span:nth-child(3n){height:90%}.r-signal span:nth-child(2n){height:60%}
+.r-cinema{display:grid;grid-template-columns:1fr 1fr;gap:45px;align-items:center;padding-bottom:110px}.r-cinema h2{margin:25px 0 35px}.r-film-wrap{position:relative;aspect-ratio:4/5;overflow:hidden;border-radius:180px 180px 8px 8px;background:#e4e3df}.r-film-wrap video{width:100%;height:100%;object-fit:cover}.r-film-toggle{position:absolute;bottom:25px;right:25px;background:var(--r-cream);border:0;border-radius:30px;padding:14px 22px;font:inherit;font-size:13px;cursor:pointer}.r-language-note{font-size:11px;color:#68695e;margin-top:20px;line-height:1.6}
+.reliv-home .sensor-explorer-section{border-top:1px solid var(--r-line);padding-top:80px}.reliv-home .sensor-stage-box{box-shadow:none;background:#ece7dc}.reliv-home .recog,.reliv-home .app-section{background:#ebe6dc}.reliv-home .org-cta-section{background:var(--r-orange)}.reliv-home footer{background:var(--r-ink);color:var(--r-cream)}.reliv-home .r-intro h2 .sw{overflow:visible}:focus-visible{outline:3px solid #b64817;outline-offset:5px}.r-paused *,.r-paused *::before,.r-paused *::after{animation-play-state:paused!important}
+.r-hero h1 [lang]:not([lang=en]){font-family:var(--font-sans);font-size:.65em;letter-spacing:-.035em;line-height:1.3}.r-hero h1:has([lang]:not([lang=en])){max-width:57%;line-height:1.05}.r-hero h1 em[lang]:not([lang=en]){font-style:normal}
+@keyframes r-marquee{to{transform:translateX(-50%)}}@keyframes r-float{50%{translate:0 -12px}}@keyframes r-enter{from{opacity:0;transform:translateY(70px) rotate(16deg)}to{opacity:1;transform:rotate(8deg)}}
+@media(min-width:1600px){.r-hero{min-height:980px}}@media(max-width:1050px){.reliv-home .main-nav{display:none}.r-hero{min-height:850px}.r-product{left:56%;width:39%;top:22%;height:60%}.r-hero h1{font-size:13vw}.r-two{right:26%;top:78%}.r-three{top:50%;right:2%}.r-one{top:21%}.r-intro{gap:35px}.r-metric-layout{gap:30px}.r-metric-detail{padding:30px}}
+@media(max-width:650px){.r-hero{padding:105px 6% 35px;min-height:0}.r-hero-top{font-size:8px}.r-hero h1{font-size:17vw;line-height:.96;margin-top:35px;max-width:100%}.r-product{position:relative;top:auto;left:auto;width:80%;height:410px;margin:-5px auto -10px}.r-orbit{width:100vw;height:100vw;top:245px;left:5%}.r-float{font-size:11px;padding:12px 15px}.r-one{top:340px;right:8%}.r-two{top:500px;right:auto;left:5%}.r-three{top:620px;right:4%}.r-hero-bottom{margin:20px 0 0;max-width:none}.r-hero-bottom p{font-size:15px}.r-scroll{display:none}.r-intro{grid-template-columns:1fr;gap:20px;padding-top:75px}.r-intro .body-lead{font-size:18px}.r-metric-layout{grid-template-columns:1fr;gap:25px}.r-metric-choices{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}.r-metric-choices button{font-size:15px;padding:17px 0}.r-metric-detail{min-height:330px;padding:30px}.r-categories button{font-size:12px;padding:12px 14px}.r-cinema{grid-template-columns:1fr;padding-bottom:65px}.r-film-wrap{aspect-ratio:1/1.1}.r-cinema h2{max-width:320px}.r-explorer{padding-bottom:60px}.reliv-home header .nav-actions>.btn{display:none}.r-language select{max-width:105px}.r-band-track>div{font-size:27px}.r-hero h1:has([lang]:not([lang=en])){max-width:100%}.r-hero h1 [lang]:not([lang=en]){font-size:.72em}}
+@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto!important}.r-product,.r-float,.r-band-track{animation:none!important}.r-band-track{width:auto}.r-band-track>div{white-space:normal;font-size:20px;line-height:2}.r-band-track>div[aria-hidden]{display:none}.r-band{padding:20px 6% 45px;width:100%;margin:0;transform:none}.r-pill{transition:none}}
